{
  "name": "@claudinho/mcp",
  "version": "0.11.0",
  "mcpName": "io.github.arturogarrido/claudinho",
  "description": "An MCP server with live football scores, fixtures, standings and paste-ready match cards for the competition you follow: the World Cup, the Premier League, LALIGA, the Champions League and 11 more. Works with Claude Code, Cursor, Codex, Claude Desktop, Windsurf, Zed and any MCP client. No API key. Independent fan project. Not affiliated with FIFA, any confederation, league or club, or Anthropic.",
  "type": "module",
  "license": "MIT",
  "author": "Arturo Garrido",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/arturogarrido/claudinho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturogarrido/claudinho.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/arturogarrido/claudinho/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claudinho-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/*.mcpb",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "world-cup",
    "world-cup-2026",
    "football",
    "soccer",
    "live-scores",
    "fixtures",
    "standings",
    "vibinglavidaloca",
    "cursor-cli",
    "cursor-agent",
    "agent",
    "euro",
    "copa-america",
    "nations-league",
    "concacaf-nations-league",
    "gold-cup",
    "premier-league",
    "laliga",
    "serie-a",
    "bundesliga",
    "liga-mx",
    "champions-league",
    "libertadores",
    "concacaf-champions-cup",
    "club-world-cup"
  ],
  "scripts": {
    "build": "tsup",
    "build:mcpb": "pnpm run build && node scripts/build-mcpb.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "smoke:stdio": "node scripts/stdio-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@claudinho/core": "workspace:*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
