{
  "name": "@claudinho/cli",
  "version": "0.11.0",
  "description": "Live football scores, fixtures and standings in your terminal and your Claude Code and Cursor CLI statusline, for the competition you follow: the World Cup, the Premier League, LALIGA, the Champions League and 12 more. No API key. Independent fan project. Not affiliated with FIFA, any confederation, league or club, or Anthropic.",
  "type": "module",
  "license": "MIT",
  "author": "Arturo Garrido",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/arturogarrido/claudinho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturogarrido/claudinho.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/arturogarrido/claudinho/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claudinho": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "world-cup",
    "world-cup-2026",
    "worldcup",
    "football",
    "soccer",
    "futbol",
    "mundial",
    "live-scores",
    "fixtures",
    "standings",
    "cli",
    "terminal",
    "statusline",
    "claude-code",
    "cursor-cli",
    "vibinglavidaloca",
    "cursor",
    "cursor-agent",
    "mcp",
    "agent",
    "euro",
    "copa-america",
    "nations-league",
    "concacaf-nations-league",
    "gold-cup",
    "premier-league",
    "laliga",
    "serie-a",
    "bundesliga",
    "liga-mx",
    "liga-auf",
    "champions-league",
    "libertadores",
    "concacaf-champions-cup",
    "club-world-cup"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@claudinho/core": "workspace:*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
