{
  "name": "@claudinho/core",
  "version": "0.11.1",
  "description": "The engine behind Claudinho: the domain model, the provider adapters (ESPN), live scores and standings for the competition you follow (16 supported), the bundled 2026 World Cup schedule with its knockout bracket and read-only Polymarket sidecar. Independent fan project. Not affiliated with FIFA, any confederation, league or club, or Anthropic.",
  "type": "module",
  "license": "MIT",
  "author": "Arturo Garrido",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/arturogarrido/claudinho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturogarrido/claudinho.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/arturogarrido/claudinho/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "world-cup",
    "world-cup-2026",
    "football",
    "soccer",
    "live-scores",
    "fixtures",
    "standings",
    "polymarket",
    "typescript",
    "cursor",
    "cursor-cli",
    "cursor-agent",
    "mcp",
    "agent",
    "euro",
    "copa-america",
    "nations-league",
    "concacaf-nations-league",
    "gold-cup",
    "premier-league",
    "laliga",
    "serie-a",
    "bundesliga",
    "liga-mx",
    "liga-auf",
    "champions-league",
    "libertadores",
    "concacaf-champions-cup",
    "club-world-cup"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:schedule": "tsx scripts/gen-schedule.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
