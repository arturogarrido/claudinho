{
  "name": "claudinho-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Live football scores, fixtures and standings in your terminal and your Claude Code and Cursor CLI statusline, for the competition you follow: the World Cup, the Premier League, LALIGA, the Champions League and 11 more.",
  "type": "module",
  "license": "MIT",
  "author": "Arturo Garrido",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "release:qa": "bash scripts/release-qa.sh",
    "check:pack": "node scripts/check-pack.mjs",
    "smoke:statusline": "node scripts/smoke-statusline.mjs",
    "canary": "node scripts/espn-canary.mjs",
    "gen:readme-matrix": "node scripts/gen-readme-matrix.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
